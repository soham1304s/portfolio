PORT=5000

# Auth & dashboard access
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
MAX_ACTIVE_TOKENS=5

# Inbox that should receive contact form notifications
CONTACT_TO_EMAIL=your-inbox@example.com

# Sender shown on the notification email
CONTACT_FROM_NAME=Soham Portfolio
CONTACT_FROM_EMAIL=your-inbox@example.com

# The dashboard inbox is available to:
# 1. Any user with role=admin
# 2. The authenticated user whose email matches CONTACT_TO_EMAIL or CONTACT_FROM_EMAIL

# Choose one SMTP setup style:

# Option 1: Well-known provider shortcut, for example "gmail" or "outlook"
SMTP_SERVICE=gmail
SMTP_USER=your-inbox@example.com
SMTP_PASS=your-smtp-password

# Option 2: Full SMTP connection details instead of SMTP_SERVICE
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Option 3: Full connection URL instead of the fields above
# SMTP_URL=smtps://username:password@smtp.example.com/?pool=true

# Spotify Integration (Client Credentials Flow)
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_PLAYLIST_ID=your-public-playlist-id
SPOTIFY_MARKET=US
SPOTIFY_PLAYLIST_LIMIT=8
SPOTIFY_PLAYLIST_CACHE_TTL_MS=300000
